---
import Layout from '../../layouts/Layout.astro';

interface AdsDoc {
  bibcode: string;
  title?: string[];
  author?: string[];
  pub?: string;
  year?: string;
  doi?: string[];
}

interface AdsResponse {
  response?: { docs?: AdsDoc[]; numFound?: number };
}

const token = process.env.ADS_TOKEN;
const ROWS = 200;

let papers: AdsDoc[] = [];
let totalFound = 0;
let fetchError: string | null = null;
let fetchedAt: string | null = null;

if (!token) {
  fetchError = 'Live publication feed disabled (ADS_TOKEN not set). Browse via the links below.';
} else {
  try {
    // Bahram Mobasher's ORCID — far more precise than the surname-based
    // query, which also matched his brother (Barzin Mobasher, ASU,
    // structural engineering). Search all three ADS ORCID sources to
    // catch papers however the link was claimed.
    const ORCID = '0000-0001-5846-4404';
    const orcidClause = `(orcid_pub:"${ORCID}" OR orcid_user:"${ORCID}" OR orcid_other:"${ORCID}")`;

    const url = new URL('https://api.adsabs.harvard.edu/v1/search/query');
    url.searchParams.set('q', `${orcidClause} property:refereed`);
    url.searchParams.set('sort', 'date desc');
    url.searchParams.set('rows', String(ROWS));
    url.searchParams.set('fl', 'bibcode,title,author,pub,year,doi');

    const res = await fetch(url, {
      headers: { Authorization: `Bearer ${token}` },
    });

    if (!res.ok) {
      const body = await res.text();
      fetchError = `ADS API returned ${res.status}: ${body.slice(0, 200)}`;
    } else {
      const json: AdsResponse = await res.json();
      papers = json.response?.docs ?? [];
      totalFound = json.response?.numFound ?? papers.length;
      fetchedAt = new Date().toISOString().slice(0, 10);
    }
  } catch (e) {
    fetchError = `Failed to reach ADS: ${(e as Error).message}`;
  }
}

function formatAuthors(authors: string[] | undefined): string {
  if (!authors || authors.length === 0) return '';
  if (authors.length <= 3) return authors.join('; ');
  return `${authors.slice(0, 3).join('; ')}; et al.`;
}

// Group papers by year, newest year first, missing year bucketed as "Other".
const byYear = new Map<string, AdsDoc[]>();
for (const p of papers) {
  const y = (p.year && /^\d{4}$/.test(p.year)) ? p.year : 'Other';
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}

const years = Array.from(byYear.keys()).sort((a, b) => {
  if (a === 'Other') return 1;
  if (b === 'Other') return -1;
  return Number(b) - Number(a);
});
---

<Layout
  title="Publications"
  description="Recent publications from the UCR Extragalactic Astrophysics Research Group."
  path="/pages/publications.html"
>
  <div class="container">
    <div id="publications" class="page active">
      <a href="../index.html" class="back-btn">&larr; Back to Home</a>
      <div class="content-section">
        <h2>Recent Publications</h2>

        {papers.length > 0 ? (
          <>
            <p class="section-intro">
              Latest {papers.length} of {totalFound.toLocaleString()} refereed papers by Bahram Mobasher and the group, fetched from
              <a href="https://ui.adsabs.harvard.edu/" target="_blank" rel="noopener noreferrer" class="inline-link">
                NASA ADS
              </a>
              {fetchedAt && ` on ${fetchedAt}`}. Click a year to expand.
            </p>

            <div class="ads-by-year">
              {years.map((y, idx) => (
                <details class="ads-year" open={idx === 0}>
                  <summary class="ads-year-summary">
                    <span class="ads-year-label">{y}</span>
                    <span class="ads-year-count">{byYear.get(y)!.length} {byYear.get(y)!.length === 1 ? 'paper' : 'papers'}</span>
                  </summary>
                  <ol class="ads-paper-list">
                    {byYear.get(y)!.map(p => (
                      <li class="ads-paper">
                        <a class="ads-paper-link"
                           href={`https://ui.adsabs.harvard.edu/abs/${p.bibcode}/abstract`}
                           target="_blank" rel="noopener noreferrer">
                          {p.title?.[0] ?? '(untitled)'}
                        </a>
                        <div class="ads-paper-meta">
                          {formatAuthors(p.author)}
                          {p.pub && ' · '}
                          {p.pub}
                        </div>
                      </li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          </>
        ) : (
          <p class="section-intro">
            Our group's contributions to extragalactic astronomy. Browse our work directly on
            NASA ADS and Google Scholar.
          </p>
        )}

        {fetchError && (
          <p class="section-note">{fetchError}</p>
        )}

        <h3 class="course-section-title">More ways to browse</h3>
        <div class="research-grid">
          <a class="research-card"
             href="https://ui.adsabs.harvard.edu/search/q=author%3A%22Mobasher%2C%20B%22&sort=date%20desc%2C%20bibcode%20desc"
             target="_blank" rel="noopener noreferrer">
            <h3>Full ADS record</h3>
            <p>Every refereed paper by the group PI, sorted by date.</p>
          </a>
          <a class="research-card"
             href="https://scholar.google.com/scholar?q=Bahram+Mobasher"
             target="_blank" rel="noopener noreferrer">
            <h3>Google Scholar</h3>
            <p>Citations and recent papers indexed by Google Scholar.</p>
          </a>
          <a class="research-card" href="people.html">
            <h3>By group member</h3>
            <p>Each member's profile lists featured publications and links to their full record.</p>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .ads-by-year {
    margin: 1.5rem 0 2.5rem 0;
  }
  .ads-year {
    border: 1px solid rgba(125, 211, 252, 0.2);
    border-radius: 12px;
    margin-bottom: 0.75rem;
    background: rgba(0, 20, 60, 0.3);
    overflow: hidden;
  }
  .ads-year[open] {
    background: rgba(0, 30, 80, 0.4);
  }
  .ads-year-summary {
    cursor: pointer;
    padding: 0.85rem 1.25rem;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    user-select: none;
    transition: background 0.2s;
  }
  .ads-year-summary::-webkit-details-marker { display: none; }
  .ads-year-summary::before {
    content: '▸';
    color: #7dd3fc;
    font-size: 0.9rem;
    transition: transform 0.2s;
    margin-right: 0.5rem;
  }
  .ads-year[open] > .ads-year-summary::before {
    transform: rotate(90deg);
  }
  .ads-year-summary:hover {
    background: rgba(0, 50, 120, 0.4);
  }
  .ads-year-label {
    font-size: 1.25rem;
    font-weight: 600;
    color: #7dd3fc;
    flex: 1;
  }
  .ads-year-count {
    color: #94a3b8;
    font-size: 0.9rem;
  }
  .ads-paper-list {
    list-style: decimal;
    padding: 0.5rem 1.25rem 1rem 3rem;
    margin: 0;
    color: #cbd5e1;
  }
  .ads-paper {
    margin-bottom: 1rem;
    line-height: 1.45;
  }
  .ads-paper-link {
    color: #7dd3fc;
    text-decoration: none;
    font-weight: 500;
  }
  .ads-paper-link:hover,
  .ads-paper-link:focus-visible {
    color: #0ff;
    text-decoration: underline;
    outline: none;
  }
  .ads-paper-meta {
    color: #94a3b8;
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }
</style>
