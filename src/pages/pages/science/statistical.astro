---
import Layout from '../../../layouts/Layout.astro';
---
<Layout
  title="Statistical Studies"
  description="Mass functions, luminosity functions, and statistical studies of galaxy properties at the UCR Extragalactic Astrophysics Group."
  path="/pages/science/statistical.html"
>
<div class="container">
<div id="statistical" class="page active">
            <a href="../science.html" class="back-btn">← Back to Science</a>
            <div class="content-section">
                <h2>Statistical Studies</h2>
                <p>Understanding galaxy populations through statistical analysis of their properties.</p>
                <div class="research-grid">
                    <div class="research-card">
                        <h3>Mass Functions</h3>
                        <p>Distribution of galaxy masses across cosmic time</p>
                    </div>
                    <div class="research-card">
                        <h3>Luminosity Functions</h3>
                        <p>Evolution of galaxy brightness distributions</p>
                    </div>
                    <div class="research-card">
                        <h3>Property Correlations</h3>
                        <p>Relationships between galaxy characteristics</p>
                    </div>
                </div>
            </div>
        </div>
</div>
</Layout>
