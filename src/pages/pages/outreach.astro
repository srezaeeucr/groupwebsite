---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Outreach"
  description="Public talks, school visits, and student-mentoring activities of the UCR Extragalactic Astrophysics Research Group."
  path="/pages/outreach.html"
>
<div class="container">
<div id="outreach" class="page active">
            <a href="../index.html" class="back-btn">&larr; Back to Home</a>
            <div class="content-section">
                <h2>Outreach</h2>
                <p class="section-intro">
                    We share the universe with our local community through public talks,
                    school visits, and student-mentoring programs at UC Riverside.
                </p>
                <p class="section-note">
                    A detailed list of past and upcoming events is being compiled.
                    To invite the group to speak or partner on an event, please contact us via the
                    <a href="people.html" class="inline-link">People</a> page.
                </p>
            </div>
        </div>
</div>
</Layout>
