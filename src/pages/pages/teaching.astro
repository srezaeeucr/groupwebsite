---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Teaching"
  description="Graduate and undergraduate courses taught by members of the UCR Extragalactic Astrophysics Research Group."
  path="/pages/teaching.html"
>
<div class="container">
<div id="teaching" class="page active">
            <a href="../index.html" class="back-btn">← Back to Home</a>
            <div class="content-section">
                <h2>Teaching</h2>
                
                <h3 class="course-section-title">Graduate Courses</h3>
                <div class="research-grid">
                    <a class="research-card" href="https://srezaeeucr.github.io/UCRAstroPython/" target="_blank" rel="noopener noreferrer">
                        <h3>Computational Astronomy Tools for PhD Students</h3>
                        <p>Advanced programming techniques, data analysis methods, and computational tools essential for modern astronomical research and PhD-level studies.</p>
                        <p class="course-cta">Visit course &rarr;</p>
                    </a>
                </div>

                <h3 class="course-section-title">Undergraduate Courses</h3>
                <div class="research-grid">
                    <a class="research-card" href="https://srezaeeucr.github.io/data_visualization_course/" target="_blank" rel="noopener noreferrer">
                        <h3>Data Visualization Fundamentals: From Excel to Python</h3>
                        <p>Learn essential data visualization techniques starting from basic Excel charts to advanced Python plotting libraries for scientific data presentation.</p>
                        <p class="course-cta">Visit course &rarr;</p>
                    </a>
                </div>
            </div>
        </div>
</div>
</Layout>
