---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="UCR Extragalactic Astrophysics Research Group"
  description="Extragalactic astrophysics research at UC Riverside, led by Distinguished Professor Bahram Mobasher: galaxy evolution, cosmic structure, and astronomical AI."
  path="/"
  withJsonLd
  extraScripts={['js/circular-layout.js']}
>
<div class="container">
<!-- Home page with circular layout -->
        <div id="home" class="page active">
            <div class="circular-layout" id="circularLayout">
                <!-- Central Science node -->
                <a class="central-node" href="pages/science.html">
                    <h2>Science</h2>
                    <p>Explore our research areas</p>
                </a>

                <!-- 13 circular nodes arranged in a circle -->
                <a class="circular-node" data-angle="0" href="pages/teaching.html">
                    <h3>Teaching</h3>
                    <p>Courses &amp; Education</p>
                </a>

                <a class="circular-node" data-angle="27.69" href="pages/publications.html">
                    <h3>Recent Publications</h3>
                    <p>Latest Research</p>
                </a>

                <a class="circular-node" data-angle="55.38" href="pages/outreach.html">
                    <h3>Outreach</h3>
                    <p>Community Engagement</p>
                </a>

                <a class="circular-node" data-angle="83.07" href="pages/people.html">
                    <h3>People</h3>
                    <p>Research Team</p>
                </a>

                <a class="circular-node" data-angle="110.76" href="pages/alumni.html">
                    <h3>Alumni</h3>
                    <p>Former Members</p>
                </a>

                <a class="circular-node" data-angle="138.45" href="pages/science/galaxy-formation.html">
                    <h3>Galaxy Formation</h3>
                    <p>&amp; Evolution</p>
                </a>

                <a class="circular-node" data-angle="166.14" href="pages/science/surveys.html">
                    <h3>Galaxy Surveys</h3>
                    <p>CANDELS, COSMOS</p>
                </a>

                <a class="circular-node" data-angle="193.83" href="pages/science/lss.html">
                    <h3>Large Scale Structure</h3>
                    <p>Cosmic Web</p>
                </a>

                <a class="circular-node" data-angle="221.52" href="pages/science/astro-ai.html">
                    <h3>Astronomy &amp; Artificial Intelligence</h3>
                    <p>Machine Learning</p>
                </a>

                <a class="circular-node" data-angle="249.21" href="pages/science/statistical.html">
                    <h3>Statistical Studies</h3>
                    <p>Mass &amp; Luminosity</p>
                </a>

                <a class="circular-node" data-angle="276.9" href="pages/science/research_interest.html">
                    <h3>Group Research Interests</h3>
                </a>

                <a class="circular-node" data-angle="304.59" href="pages/science/highz.html">
                    <h3>High-z Objects</h3>
                    <p>High Redshift</p>
                </a>

                <a class="circular-node" data-angle="332.28" href="pages/science/instruments.html">
                    <h3>Instruments</h3>
                    <p>HST, JWST, Euclid</p>
                </a>
            </div>
        </div>
</div>
</Layout>
